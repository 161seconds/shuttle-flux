# Core inference selection: auto | pytorch | onnx | tensorrt
VISION_BACKEND=auto
YOLO_MODEL_PATH=yolov8n.pt
YOLO_ONNX_PATH=models/yolov8n.onnx
YOLO_TENSORRT_PATH=models/yolov8n.engine

# Optional gated/heavy models
ENABLE_SAM3=0
SAM3_MODEL_PATH=models/sam3.pt
SAM3_FRAME_INTERVAL=10
ENABLE_OSNET=0
OSNET_MODEL_PATH=models/osnet_x0_25.onnx
OSNET_ALLOW_DOWNLOAD=0

# Dedicated Flask inference service
INFERENCE_SERVICE_URL=http://127.0.0.1:5001
INFERENCE_SERVICE_TIMEOUT_SEC=30
INFERENCE_JPEG_QUALITY=88

# Preserve the uploaded video and normalize only the worker's analysis copy
ENABLE_FFMPEG_NORMALIZATION=1
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20

# Development services
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
